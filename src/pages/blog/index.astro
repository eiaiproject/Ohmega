---
import BaseLayout from '../../layouts/BlogLayout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import { getAllArticles } from '../../lib/content';
import { site } from '../../data/site';

const articles = await getAllArticles();
const pageTitle = `Edukasi & Resep | Blog OHMEGA`;
const pageDescription = `Artikel edukasi tentang telur omega, gizi keluarga, dan resep praktis dari tim OHMEGA ${site.serviceArea}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <header class="text-center mb-10 lg:mb-14">
    <p class="text-sm font-extrabold uppercase tracking-wider text-primary">Blog OHMEGA</p>
    <h1 class="mt-3 text-[clamp(1.875rem,4vw+0.5rem,3rem)] font-extrabold leading-tight text-text text-balance">
      Edukasi Telur Omega untuk Keluarga
    </h1>
    <p class="mt-4 text-base lg:text-lg text-text-muted leading-relaxed">
      Pelajari manfaat Omega-3, DHA, dan EPA untuk keluarga, plus resep praktis sehari-hari.
    </p>
  </header>

  {
    articles.length === 0 ? (
      <div class="text-center py-16">
        <p class="text-text-muted">Belum ada artikel yang dipublikasikan.</p>
        <a href="/" class="mt-4 inline-block text-primary font-semibold hover:underline">
          Kembali ke beranda →
        </a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    )
  }
</BaseLayout>
