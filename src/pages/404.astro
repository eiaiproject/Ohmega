---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
---
<BaseLayout title="Halaman tidak ditemukan | OHMEGA" description="Halaman yang Anda cari tidak tersedia atau telah dipindahkan.">
  <section class="py-24 lg:py-32">
    <Container class="text-center max-w-xl">
      <p class="text-sm font-extrabold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl lg:text-4xl font-extrabold text-text text-balance">Halaman tidak ditemukan</h1>
      <p class="mt-4 text-text-muted">Halaman yang Anda cari tidak tersedia atau telah dipindahkan.</p>
      <div class="mt-8 inline-flex">
        <Button href="/" variant="primary" size="lg" iconRight="arrow_right">Kembali ke Beranda</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
