---
import Container from '../common/Container.astro';
import ProductCard from './ProductCard.astro';
import { products } from '../../data/products';

const available = products.filter(p => p.status === 'available');
---
<section id="produk" class="py-16 lg:py-24 bg-white border-y border-border">
  <Container>
    <div class="max-w-2xl">
      <p class="text-sm font-extrabold uppercase tracking-wider text-primary">Produk</p>
      <h2 class="mt-2 text-3xl font-extrabold leading-tight text-text sm:text-[2.5rem] text-balance">
        Pilih Kemasan Sesuai Kebutuhan
      </h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted sm:text-lg">
        OHMEGA tersedia dalam pilihan isi 4, 10, dan 30. Pesan via WhatsApp, tentukan cara terima yang paling cepat.
      </p>
    </div>

    {available.length > 0 ? (
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {available.map((p, i) => <li class:list={['reveal', `reveal-delay-${i + 1}`, 'h-full']}><ProductCard product={p} /></li>)}
      </ul>
    ) : (
      <div class="mt-12 rounded-card-lg border border-border bg-soft-green-soft p-8 text-center">
        <p class="text-lg font-extrabold text-text">Stok sedang disiapkan</p>
        <p class="mt-2 text-sm text-text-muted">Semua kemasan habis untuk saat ini. Hubungi kami melalui WhatsApp untuk info ketersediaan.</p>
      </div>
    )}
  </Container>
</section>
