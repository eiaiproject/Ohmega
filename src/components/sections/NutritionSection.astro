---
import Container from '../common/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import Icon from '../common/Icon.astro';
import { nutrition, nutritionNote } from '../../data/nutrition';
---
<section id="kandungan" class="py-16 lg:py-24">
  <Container>
    <SectionHeading
      title="Kandungan Baik dalam Setiap Pilihan"
      description="Kenali kandungan utama yang terdapat dalam produk OHMEGA."
    />
    <div class="mt-4 inline-block rounded-full bg-soft-green px-4 py-1.5 text-xs font-bold text-primary">
      Kandungan per 100 gram
    </div>
    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {nutrition.map(n => (
        <li class:list={['reveal rounded-card-lg border p-6 lg:p-8', n.featured ? 'bg-primary border-primary text-white shadow-card' : 'bg-white border-border shadow-card card-hover']}>
          <span class:list={['inline-flex h-12 w-12 items-center justify-center rounded-full', n.featured ? 'bg-white/15 text-white' : 'bg-yolk-soft text-primary']}>
            <Icon name={n.icon} size={24} decorative />
          </span>
          <p class:list={['mt-6 text-5xl lg:text-6xl font-extrabold leading-none', n.featured ? 'text-white' : 'text-text']}>
            {n.value}<span class:list={['text-2xl lg:text-3xl font-bold ml-1', n.featured ? 'text-soft-green' : 'text-text-muted']}>{n.unit}</span>
          </p>
          <p class:list={['mt-3 text-base font-bold', n.featured ? 'text-white' : 'text-text']}>{n.name}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm text-text-muted max-w-2xl">{nutritionNote}</p>
  </Container>
</section>
