---
import Container from '../common/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import Icon from '../common/Icon.astro';

const nkvNumber = 'BUP 3516070-053';
const nkvLink = 'https://sisnasnkv.ditjenpkh.pertanian.go.id/site/front-end?sort=jenis_produk&page=344&FrontEnd%5Bkriteria_front_end%5D=3&FrontEnd%5Bvalue_front_end%5D=BUP+3516070-053&FrontEnd%5Btingkat%5D=&FrontEnd%5Bid_jenis_usaha%5D=&FrontEnd%5Bid_provinsi%5D=';
---
<section id="sertifikasi" class="py-16 lg:py-24">
  <Container>
    <SectionHeading
      title="Mutu yang Dapat Dipercaya"
      description="Hasil pengujian laboratorium SIG dan dokumen pendukung produk ditampilkan di sini."
    />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- NKV: terverifikasi -->
      <li class="reveal rounded-card-lg border border-border bg-white p-6 flex flex-col items-center text-center shadow-card card-hover">
        <div class="h-28 w-28 rounded-card bg-soft-green border border-primary/10 flex items-center justify-center p-3">
          <img src="/certifications/nkv.svg" alt="Logo NKV" width="100" height="100" loading="lazy" class="max-h-full max-w-full" />
        </div>
        <p class="mt-4 text-base font-extrabold text-text">NKV</p>
        <p class="mt-1 text-sm text-text-muted">Nomor Kontrol Veteriner</p>
        <p class="mt-3 text-xs font-bold text-primary">{nkvNumber}</p>
        <a
          href={nkvLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1.5 text-xs text-primary underline hover:text-primary-dark"
          data-track="cert_click"
          data-source="nkv"
        >
          Verifikasi di SISNASKV
          <Icon name="external_link" size={12} decorative />
        </a>
      </li>

      <!-- SIG: laboratorium pengujian -->
      <li class="reveal rounded-card-lg border border-border bg-white p-6 flex flex-col items-center text-center shadow-card card-hover">
        <div class="h-28 w-28 rounded-card bg-white border border-border flex items-center justify-center p-2">
          <img src="/certifications/sig.png" alt="Logo SIG Laboratory" width="500" height="190" loading="lazy" class="max-h-full max-w-full" />
        </div>
        <p class="mt-4 text-base font-extrabold text-text">SIG</p>
        <p class="mt-1 text-sm text-text-muted">Laboratorium pengujian</p>
        <p class="mt-3 text-xs font-bold text-primary">Nomor: 17.1.F.FP</p>
        <a
          href="https://siglaboratory.com/id/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1.5 text-xs text-primary underline hover:text-primary-dark"
          data-track="cert_click"
          data-source="sig"
        >
          Situs SIG Laboratory
          <Icon name="external_link" size={12} decorative />
        </a>
      </li>

      <!-- Halal: pernyataan produk -->
      <li class="reveal rounded-card-lg border border-border bg-white p-6 flex flex-col items-center text-center shadow-card card-hover">
        <div class="h-28 w-28 rounded-card bg-soft-green-soft border border-border flex items-center justify-center p-3">
          <img src="/certifications/halal.svg" alt="" width="100" height="100" loading="lazy" class="max-h-full max-w-full" />
        </div>
        <p class="mt-4 text-base font-extrabold text-text">Halal</p>
        <p class="mt-1 text-sm text-text-muted">Produk halal</p>
        <p class="mt-3 text-xs text-text-muted">OHMEGA halal dan aman untuk dikonsumsi.</p>
      </li>
    </ul>
  </Container>
</section>
