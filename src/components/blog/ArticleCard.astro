---
import Icon from '../common/Icon.astro';
import type { Article } from '../../lib/content';

interface Props {
  article: Article;
  class?: string;
}

const { article, class: className = '' } = Astro.props;
const { title, slug, description, hero, heroAlt, date, tags } = article.data;
const articleSlug = slug || article.id;
const formattedDate = date.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class:list={['group flex flex-col bg-surface rounded-card overflow-hidden shadow-card hover:shadow-soft transition-shadow', className]}>
  <a href={`/blog/${articleSlug}`} class="block">
    {
      hero ? (
        <div class="aspect-[16/9] w-full overflow-hidden bg-soft-green-soft">
          <img
            src={hero}
            alt={heroAlt || title}
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      ) : (
        <div class="aspect-[16/9] w-full bg-soft-green-soft flex items-center justify-center">
          <Icon name="nutrition" size={48} class="text-primary/30" />
        </div>
      )
    }
  </a>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2 text-xs text-text-muted">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {tags.length > 0 && <span aria-hidden="true">·</span>}
      {tags[0] && <span class="font-semibold text-primary">{tags[0]}</span>}
    </div>
    <h3 class="mt-2 text-lg font-extrabold text-text leading-snug">
      <a href={`/blog/${articleSlug}`} class="hover:text-primary transition-colors">{title}</a>
    </h3>
    <p class="mt-2 text-sm text-text-muted leading-relaxed line-clamp-3">{description}</p>
    <a
      href={`/blog/${articleSlug}`}
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:gap-2.5 transition-all"
    >
      Baca selengkapnya
      <Icon name="arrow_right" size={16} />
    </a>
  </div>
</article>
