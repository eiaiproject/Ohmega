---
import type { Article } from '../../lib/content';

interface Props {
  article: Article;
  class?: string;
}

const { article, class: className = '' } = Astro.props;
const { date, tags } = article.data;
const formattedDate = date.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<div class:list={['flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-text-muted', className]}>
  <time datetime={date.toISOString()}>{formattedDate}</time>
  {
    tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5">
        {tags.map((tag) => (
          <span class="inline-flex items-center rounded-full bg-soft-green-soft px-2.5 py-0.5 text-xs font-semibold text-primary">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</div>
