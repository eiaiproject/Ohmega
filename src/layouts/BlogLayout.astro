---
import '../assets/styles/global.css';
import { seoDefaults } from '../utils/seo';
import { site } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/common/Container.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  heroImage?: string;
  publishDate?: Date;
  tags?: string[];
  ogAlt?: string;
  /** Og image cache-busting; default = versi global. */
  imageVersion?: number;
}

const {
  title,
  description,
  canonical,
  heroImage,
  publishDate,
  tags,
  ogAlt,
  imageVersion = site.ogImageVersion,
} = Astro.props;

const url = canonical
  ? new URL(canonical, site.siteUrl).toString()
  : new URL(Astro.url.pathname, site.siteUrl).toString();

const image = heroImage
  ? `${site.siteUrl}${heroImage}?v=${imageVersion}`
  : `${site.siteUrl}${site.ogImage}?v=${imageVersion}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173F2C" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={site.favicon} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog OHMEGA" href="/blog/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:locale" content={seoDefaults.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={seoDefaults.imageWidth} />
    <meta property="og:image:height" content={seoDefaults.imageHeight} />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {tags?.map((t) => <meta property="article:tag" content={t} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten utama</a>
    <Header />
    <main id="main">
      <article class="pt-10 pb-16 lg:pt-14 lg:pb-24">
        <Container>
          <div class="max-w-2xl mx-auto">
            <slot />
          </div>
        </Container>
      </article>
    </main>
    <Footer />
    <script>
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest('[data-track]');
        if (!el) return;
        const event = el.getAttribute('data-track')!;
        const detail: Record<string, string> = { source: el.getAttribute('data-source') || '' };
        const pkg = el.getAttribute('data-package');
        if (pkg) detail.package = pkg;
        window.dispatchEvent(new CustomEvent('ohmega:track', { detail: { event, ...detail, ts: Date.now() } }));
      });
    </script>
  </body>
</html>
